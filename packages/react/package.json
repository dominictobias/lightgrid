{
  "name": "@lightgrid/react",
  "description": "A fast, lightweight, full-featured Datagrid for React",
  "keywords": [
    "react",
    "reactjs",
    "datagrid",
    "table"
  ],
  "version": "0.1.5",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "dist/lib.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "homepage": "https://github.com/dominictobias/lightgrid",
  "repository": {
    "type": "git",
    "url": "https://github.com/dominictobias/lightgrid.git"
  },
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "build:demos": "tsc && vite build --base=/demos/",
    "build:lib": "tsc && BUILD_MODE=lib bun --bun vite build",
    "prepublishOnly": "bun run build:lib",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^6.0.4",
    "cancelable-promise": "^4.3.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "prettier-plugin-jsdoc": "^1.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-range-slider-input": "^3.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "wouter": "^3.10.0"
  },
  "dependencies": {
    "@lightgrid/core": "workspace:^"
  }
}
